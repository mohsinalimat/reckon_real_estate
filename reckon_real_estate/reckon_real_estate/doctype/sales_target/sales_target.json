{
  "doctype": "DocType",
  "name": "Sales Target",
  "module": "Reckon Real Estate",
  "autoname": "format:ST-{YYYY}-{#####}",
  "track_changes": 1,
  "field_order": [
    "record_title",
    "company",
    "project",
    "sales_person",
    "from_date",
    "to_date",
    "target_units",
    "target_amount",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "record_title",
      "label": "Name",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1,
      "in_list_view": 1,
      "allow_on_submit": 1,
      "print_hide": 1,
      "length": 140
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "label": "Company"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "label": "Project"
    },
    {
      "fieldname": "sales_person",
      "fieldtype": "Link",
      "options": "Sales Person",
      "label": "Sales Person"
    },
    {
      "fieldname": "from_date",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "From Date"
    },
    {
      "fieldname": "to_date",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "To Date"
    },
    {
      "fieldname": "target_units",
      "fieldtype": "Int",
      "default": "0",
      "label": "Target Units"
    },
    {
      "fieldname": "target_amount",
      "fieldtype": "Currency",
      "reqd": 1,
      "label": "Target Amount"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "record_title",
  "show_title_field_in_link": 1,
  "search_fields": "record_title,project"

{
  "doctype": "DocType",
  "name": "Sales Agreement",
  "module": "Reckon Real Estate",
  "autoname": "format:SA-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": [
    "record_title",
    "agreement_no",
    "details_section",
    "booking",
    "customer",
    "project",
    "unit",
    "agreement_date",
    "details_column",
    "company",
    "contract_value",
    "discount",
    "net_contract_value",
    "booking_money",
    "status",
    "document_status",
    "party_section",
    "seller_legal_name",
    "seller_address",
    "authorized_signatory",
    "buyer_name",
    "buyer_address",
    "buyer_nid_passport",
    "buyer_phone",
    "buyer_email",
    "property_section",
    "property_description",
    "parking_details",
    "included_facilities",
    "possession_date",
    "registration_cost_borne_by",
    "payment_terms_section",
    "payment_instructions",
    "payment_default_terms",
    "cancellation_refund_terms",
    "handover_section",
    "handover_conditions",
    "utility_maintenance_terms",
    "defect_liability_terms",
    "legal_section",
    "registration_document_terms",
    "dispute_resolution_terms",
    "annexure_documents",
    "terms_section",
    "special_terms",
    "terms",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "record_title",
      "label": "Name",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1,
      "in_list_view": 1,
      "allow_on_submit": 1,
      "print_hide": 1,
      "length": 140
    },
    {
      "fieldname": "agreement_no",
      "label": "Agreement No",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 0
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "booking",
      "label": "Property Booking",
      "fieldtype": "Link",
      "options": "Property Booking",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "read_only": 1
    },
    {
      "fieldname": "project",
      "label": "Real Estate Project",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "read_only": 1
    },
    {
      "fieldname": "unit",
      "label": "Real Estate Unit",
      "fieldtype": "Link",
      "options": "Real Estate Unit",
      "read_only": 1
    },
    {
      "fieldname": "agreement_date",
      "label": "Agreement Date",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "read_only": 1
    },
    {
      "fieldname": "contract_value",
      "label": "Contract Value",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "discount",
      "label": "Discount",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "net_contract_value",
      "label": "Net Contract Value",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "booking_money",
      "label": "Booking Money",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Agreement Status",
      "fieldtype": "Select",
      "options": "Draft\nActive\nCompleted\nCancelled",
      "default": "Draft",
      "read_only": 1
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "party_section",
      "label": "Parties to the Agreement",
      "fieldtype": "Section Break",
      "description": "Select a Property Booking to fill linked details and editable Bangladesh sample terms. Review missing identity, signatory, approval and commercial details before signing."
    },
    {
      "fieldname": "seller_legal_name",
      "label": "Seller / Developer Legal Name",
      "fieldtype": "Data",
      "fetch_from": "company.company_name",
      "fetch_if_empty": 1
    },
    {
      "fieldname": "seller_address",
      "label": "Seller / Developer Address",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "authorized_signatory",
      "label": "Authorized Signatory",
      "fieldtype": "Data"
    },
    {
      "fieldname": "buyer_name",
      "label": "Buyer Name",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "buyer_address",
      "label": "Buyer Address",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "buyer_nid_passport",
      "label": "Buyer NID / Passport No.",
      "fieldtype": "Data"
    },
    {
      "fieldname": "buyer_phone",
      "label": "Buyer Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "buyer_email",
      "label": "Buyer Email",
      "fieldtype": "Data",
      "options": "Email"
    },
    {
      "fieldname": "property_section",
      "label": "Property, Facilities and Handover",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "property_description",
      "label": "Property Details from Masters",
      "fieldtype": "Text Editor",
      "read_only": 1,
      "description": "Snapshot of project, building, floor, unit, product and land details when the agreement is prepared."
    },
    {
      "fieldname": "parking_details",
      "label": "Parking / Ancillary Space Details",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "included_facilities",
      "label": "Included Facilities and Specifications",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "possession_date",
      "label": "Expected Possession / Handover Date",
      "fieldtype": "Date",
      "description": "Initially copied from expected project completion; confirm the agreed delivery date."
    },
    {
      "fieldname": "registration_cost_borne_by",
      "label": "Registration and Transfer Costs Borne By",
      "fieldtype": "Select",
      "options": "Buyer\nSeller / Developer\nAs Agreed in Special Terms",
      "default": "As Agreed in Special Terms"
    },
    {
      "fieldname": "payment_terms_section",
      "label": "Payment, Default and Cancellation",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "payment_instructions",
      "label": "Payment Instructions and Included / Excluded Charges",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "payment_default_terms",
      "label": "Late Payment / Default Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "cancellation_refund_terms",
      "label": "Cancellation / Refund Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "handover_section",
      "label": "Handover, Utilities and Warranty",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "handover_conditions",
      "label": "Handover Conditions",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "utility_maintenance_terms",
      "label": "Utility, Service Charge and Maintenance Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "defect_liability_terms",
      "label": "Defect Liability / Warranty Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "legal_section",
      "label": "Registration, Notices and Annexures",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "registration_document_terms",
      "label": "Registration, Title and Document Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "dispute_resolution_terms",
      "label": "Notices and Dispute Resolution Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "annexure_documents",
      "label": "Annexures / Documents Forming Part of Agreement",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "terms_section",
      "label": "Additional Terms and Conditions",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "special_terms",
      "label": "Special Commercial Terms",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "terms",
      "label": "Terms and Conditions",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Sales Agreement",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "record_title",
  "show_title_field_in_link": 1,
  "search_fields": "record_title,agreement_no,customer,project,unit"
}
